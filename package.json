{
  "name": "@concentrate/cli",
  "version": "0.1.4",
  "private": true,
  "license": "MIT",
  "description": "Concentrate AI: one key for every coding agent (beta)",
  "type": "module",
  "bin": {
    "cn": "./dist/bin/cn.js"
  },
  "files": [
    "dist",
    "install.sh"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint src test scripts vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm test",
    "release:pack": "pnpm build && node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.25.12",
    "eslint": "^9.39.5",
    "jsonc-parser": "3.3.1",
    "prettier": "^3.9.10",
    "smol-toml": "1.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@11.28.10"
}
